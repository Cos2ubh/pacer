{
  "manifest_version": 3,
  "name": "Pacer",
  "version": "0.1.0",
  "description": "Speeds up slow speakers on YouTube by measuring how fast they actually talk. Runs locally, collects nothing.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Pacer" },
  "commands": {
    "toggle-enabled": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Turn Pacer on or off"
    }
  }
}
